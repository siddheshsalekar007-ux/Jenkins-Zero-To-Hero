pipeline {
  agent {
    docker {
      image 'siddhesh683/maven-siddhesh-docker-agent:v1'
      args '--user root -v /var/run/docker.sock:/var/run/docker.sock' // mount Docker socket to access the host's Docker daemon
      reuseNode true
    }
  }
  stages {
    stage('Checkout') {
      steps {
        sh 'echo passed'
        
      }
    }
    stage('Build and Test') {
      steps {
        sh 'ls -ltr'
        // build the project and create a JAR file
        sh 'cd java-maven-sonar-argocd-helm-k8s/spring-boot-app && mvn clean package'
      }
    }
    stage('Static Code Analysis') {
    environment {
        SONAR_URL = "http://18.225.37.92:9000/"
    }
    steps {
        withCredentials([
            string(
                credentialsId: 'sonarqube',
                variable: 'SONAR_AUTH_TOKEN'
            )
        ]) {
            sh '''
                cd java-maven-sonar-argocd-helm-k8s/spring-boot-app

                mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                  -Dsonar.token=$SONAR_AUTH_TOKEN \
                  -Dsonar.host.url=$SONAR_URL
            '''
        }
    }
}
    stage('Build and Push Docker Image') {
      environment {
        DOCKER_IMAGE = "siddhesh683/ultimate-cicd:${BUILD_NUMBER}"
        // DOCKERFILE_LOCATION = "java-maven-sonar-argocd-helm-k8s/spring-boot-app/Dockerfile"
        REGISTRY_CREDENTIALS = credentials('docker-cred')
      }
      steps {
        script {
            sh 'cd java-maven-sonar-argocd-helm-k8s/spring-boot-app && docker build -t ${DOCKER_IMAGE} .'
            def dockerImage = docker.image("${DOCKER_IMAGE}")
            docker.withRegistry('https://index.docker.io/v1/', "docker-cred") {
                dockerImage.push()
            }
        }
      }
    }
steps {
    withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
        sh '''
            echo "Current directory:"
            pwd

            echo "Workspace:"
            echo "$WORKSPACE"

            echo "Marking Jenkins workspace as safe:"
            git config --global --add safe.directory "$WORKSPACE"

            echo "Checking Git repository:"
            git status

            git config user.email "siddheshsalekar007@gmail.com"
            git config user.name "Siddhesh Salekar"

            echo "Updating deployment image tag..."
            sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml

            git add java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml

            git commit -m "Update deployment image to version ${BUILD_NUMBER}"

            git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git HEAD:main
        '''
    }
}
  }
}
